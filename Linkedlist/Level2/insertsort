#include <stdio.h>
#include <stdlib.h>

// Node structure
struct Node {
    int data;
    struct Node *next;
};

// Insert into sorted linked list
struct Node* insertSorted(struct Node *head, int value) {
    struct Node *newNode, *temp;

    newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = value;
    newNode->next = NULL;

    // Case 1: Empty list or insert at beginning
    if (head == NULL || value < head->data) {
        newNode->next = head;
        return newNode;
    }

    // Traverse to correct position
    temp = head;
    while (temp->next != NULL && temp->next->data < value) {
        temp = temp->next;
    }

    // Insert node
    newNode->next = temp->next;
    temp->next = newNode;

    return head;
}

// Display linked list
void display(struct Node *head) {
    struct Node *temp = head;
    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }
    printf("NULL\n");
}

int main() {
    struct Node *head = NULL;
    int n, i, value;

    printf("Enter number of nodes (sorted order): ");
    scanf("%d", &n);

    // Create initial sorted list
    for (i = 0; i < n; i++) {
        printf("Enter value: ");
        scanf("%d", &value);
        head = insertSorted(head, value);
    }

    printf("\nSorted Linked List:\n");
    display(head);

    printf("\nEnter value to insert: ");
    scanf("%d", &value);

    head = insertSorted(head, value);

    printf("\nAfter Insertion:\n");
    display(head);

    return 0;
}
